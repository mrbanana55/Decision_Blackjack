# ==============================================================================
# Decision_Blackjack Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=decision_blackjack
DB_PORT=5432

# Backend Service Configuration (FastAPI)
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Service Configuration (Vite + React)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# External AI Model Providers
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=your_jev_api_key_here
TYPESAFE_MODEL=jev-latest

# Laya 
LAYA_BASE_URL=http://api.laya.example.com
LAYA_TIMEOUT_SECONDS=15